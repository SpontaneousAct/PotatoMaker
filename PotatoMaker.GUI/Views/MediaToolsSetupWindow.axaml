<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PotatoMaker.GUI.Views.MediaToolsSetupWindow"
        Icon="/Assets/potato.ico"
        Title="Set up PotatoMaker media tools"
        Width="780"
        Height="720"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="18">
        <StackPanel Grid.Row="0" Spacing="7">
            <TextBlock Text="Set up required media tools"
                       FontSize="24"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="PotatoMaker does not include or redistribute FFmpeg or VLC. Automatic setup downloads the exact third-party archives shown below directly from their providers."
                       TextWrapping="Wrap"
                       Opacity="0.78" />
            <TextBlock x:Name="DownloadSummaryTextBlock"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12"
                        Margin="0,0,8,0">
                <Border Classes="pm-card" Padding="16">
                    <StackPanel Spacing="7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="FFmpeg"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="FfmpegStatusTextBlock"
                                           TextWrapping="Wrap"
                                           Opacity="0.78" />
                            </StackPanel>
                            <Button x:Name="FfmpegManualDownloadButton"
                                    Grid.Column="1"
                                    Content="Download ZIP manually"
                                    VerticalAlignment="Center"
                                    Click="OnFfmpegManualDownloadClick" />
                        </Grid>

                        <Grid ColumnDefinitions="92,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="4">
                            <TextBlock Text="Version" FontWeight="SemiBold" />
                            <SelectableTextBlock x:Name="FfmpegVersionTextBlock"
                                                 Grid.Column="1"
                                                 TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="Provider" FontWeight="SemiBold" />
                            <SelectableTextBlock x:Name="FfmpegProviderTextBlock"
                                                 Grid.Row="1" Grid.Column="1"
                                                 TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Text="Archive" FontWeight="SemiBold" />
                            <SelectableTextBlock x:Name="FfmpegUrlTextBlock"
                                                 Grid.Row="2" Grid.Column="1"
                                                 TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Text="Installs to" FontWeight="SemiBold" />
                            <SelectableTextBlock x:Name="FfmpegDestinationTextBlock"
                                                 Grid.Row="3" Grid.Column="1"
                                                 TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Manual setup: copy ffmpeg.exe and ffprobe.exe from the ZIP's bin folder directly into the install folder above, then choose Check again."
                                   TextWrapping="Wrap"
                                   Opacity="0.78" />
                    </StackPanel>
                </Border>

                <Border Classes="pm-card" Padding="16">
                    <StackPanel Spacing="7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="VLC / LibVLC"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="LibVlcStatusTextBlock"
                                           TextWrapping="Wrap"
                                           Opacity="0.78" />
                            </StackPanel>
                            <Button x:Name="LibVlcManualDownloadButton"
                                    Grid.Column="1"
                                    Content="Download ZIP manually"
                                    VerticalAlignment="Center"
                                    Click="OnLibVlcManualDownloadClick" />
                        </Grid>

                        <Grid ColumnDefinitions="92,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="4">
                            <TextBlock Text="Version" FontWeight="SemiBold" />
                            <SelectableTextBlock x:Name="LibVlcVersionTextBlock"
                                                 Grid.Column="1"
                                                 TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="Provider" FontWeight="SemiBold" />
                            <SelectableTextBlock x:Name="LibVlcProviderTextBlock"
                                                 Grid.Row="1" Grid.Column="1"
                                                 TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Text="Archive" FontWeight="SemiBold" />
                            <SelectableTextBlock x:Name="LibVlcUrlTextBlock"
                                                 Grid.Row="2" Grid.Column="1"
                                                 TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Text="Installs to" FontWeight="SemiBold" />
                            <SelectableTextBlock x:Name="LibVlcDestinationTextBlock"
                                                 Grid.Row="3" Grid.Column="1"
                                                 TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Manual setup: extract the contents of the ZIP's vlc-3.0.23 folder directly into the install folder above, then choose Check again."
                                   TextWrapping="Wrap"
                                   Opacity="0.78" />
                    </StackPanel>
                </Border>

                <Border Classes="pm-inset" Padding="14,12">
                    <StackPanel Spacing="5">
                        <TextBlock Text="What automatic setup does"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Downloads over HTTPS, verifies each pinned archive against the SHA-256 fingerprint built into this PotatoMaker release, extracts only the required runtime files, and stores them in your local app data. Temporary downloads are removed afterward. FFmpeg and VLC remain subject to their own licenses."
                                   TextWrapping="Wrap"
                                   Opacity="0.78" />
                        <SelectableTextBlock x:Name="HashSummaryTextBlock"
                                             TextWrapping="Wrap"
                                             FontSize="11"
                                             Opacity="0.68" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ProgressPanel"
                            Spacing="8"
                            IsVisible="False">
                    <ProgressBar x:Name="DownloadProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="6" />
                    <TextBlock x:Name="ProgressTextBlock"
                               TextWrapping="Wrap"
                               Opacity="0.78" />
                </StackPanel>

                <TextBox x:Name="StatusTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="56"
                         MaxHeight="130"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         IsVisible="False" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,Auto,*,Auto,Auto"
              ColumnSpacing="10">
            <Button x:Name="OpenRuntimeFolderButton"
                    Grid.Column="0"
                    Content="Open install folder"
                    Click="OnOpenRuntimeFolderClick" />
            <Button x:Name="CheckAgainButton"
                    Grid.Column="1"
                    Content="Check again"
                    Click="OnCheckAgainClick" />
            <Button x:Name="ExitButton"
                    Grid.Column="3"
                    MinWidth="80"
                    Content="Exit"
                    Click="OnExitClick" />
            <Button x:Name="DownloadButton"
                    Grid.Column="4"
                    Content="Download and install"
                    Classes="pm-primary"
                    FontWeight="SemiBold"
                    Click="OnDownloadClick" />
        </Grid>
    </Grid>
</Window>
